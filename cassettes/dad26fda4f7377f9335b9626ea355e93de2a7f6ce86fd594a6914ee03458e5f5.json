essage {\n      min-height:1.4em;\n    }\n    footer { border-top:1px solid var(--line); padding:24px; color:var(--muted); margin-top:40px; }\n  </style>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n\n  <header class=\"site\">\n    <a class=\"brand\" href=\"/\">Harbor Bank</a>\n    <nav aria-label=\"Primary\">\n      <a href=\"/accounts\">Accounts</a>\n      <a href=\"/loans\">Loans</a>\n      <a href=\"/support\">Support</a>\n    </nav>\n  </header>\n\n  <main id=\"main-content\">\n    <h1>Contact our team</h1>\n    <p class=\"lede\">Questions about your account? Send us a note and we'll reply within one business day.</p>\n\n    <form aria-label=\"Contact form\">\n      <div class=\"row\">\n        <div class=\"field\">\n          <label for=\"first\">First name <span class=\"required-indicator\" aria-hidden=\"true\">*</span></label>\n          <input id=\"first\" name=\"first\" type=\"text\" autocomplete=\"given-name\" required aria-required=\"true\">\n        </div>\n        <div class=\"field\">\n          <label for=\"last\">Last name <span class=\"required-indicator\" aria-hidden=\"true\">*</span></label>\n          <input id=\"last\" name=\"last\" type=\"text\" autocomplete=\"family-name\" required aria-required=\"true\">\n        </div>\n      </div>\n\n      <div class=\"field\">\n        <label for=\"email\">Email address <span class=\"required-indicator\" aria-hidden=\"true\">*</span></label>\n        <input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" required aria-required=\"true\">\n      </div>\n\n      <div class=\"field\">\n        <label for=\"reason\">Reason for contact</label>\n        <select id=\"reason\" name=\"reason\" autocomplete=\"off\">\n          <option>General question</option>\n          <option>Report a problem</option>\n          <option>Close my account</option>\n        </select>\n      </div>\n\n      <div class=\"field\">\n        <label for=\"message\">Message 