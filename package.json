{
  "name": "a11yforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that fixes WCAG violations and proves how often a scanner-clean fix is still unusable to a screen-reader user.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "eval": "tsc && node dist/eval/run-eval.js",
    "ablation": "tsc && node dist/eval/ablation-gated.js",
    "report": "tsc && node dist/eval/build-report.js",
    "trajectories": "tsc && node dist/eval/export-trajectories.js",
    "determinism": "tsc && node dist/eval/determinism-proof.js"
  },
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/playwright": "0.19.1",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "axe-core": "4.13.0",
    "cheerio": "1.2.0",
    "openai": "7.8.0",
    "pa11y": "10.0.0",
    "playwright": "1.62.1",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
