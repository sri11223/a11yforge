{
  "name": "a11yforge",
  "version": "0.1.0",
  "type": "module",
  "description": "An agent that fixes WCAG violations and proves how often a scanner-clean fix is still unusable to a screen-reader user.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe",
    "pa11y",
    "screen-reader",
    "keyboard",
    "agent",
    "ci",
    "audit"
  ],
  "homepage": "https://github.com/sri11223/a11yforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sri11223/a11yforge.git"
  },
  "bugs": {
    "url": "https://github.com/sri11223/a11yforge/issues"
  },
  "author": "sri11223",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "a11yforge": "dist/src/cli/audit.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "eval": "tsc && node dist/eval/run-eval.js",
    "ablation": "tsc && node dist/eval/ablation-gated.js",
    "trajectories": "tsc && node dist/eval/export-trajectories.js",
    "determinism": "tsc && node dist/eval/determinism-proof.js",
    "audit": "tsc && node dist/src/cli/audit.js audit",
    "snapshot-real": "tsc && node dist/eval/snapshot-real.js",
    "audit-real": "tsc && node dist/eval/audit-real.js"
  },
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@guidepup/playwright": "0.19.1",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "axe-core": "4.13.0",
    "cheerio": "1.2.0",
    "openai": "7.8.0",
    "pa11y": "10.0.0",
    "playwright": "1.62.1",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
